{
  "name": "beihu-web",
  "compatibility_date": "2026-09-22",
  // Worker 入口：/api/* 反代 beihu.me；其余走 dist 静态资源（SPA 回退）
  "main": "worker.ts",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // SPA 回退会吞掉一切未命中路径（含 /api/*），必须让 API 路径先进 Worker 反代
    "run_worker_first": ["/api/*", "/version.json", "/notifications-sw.js"]
  }
}
